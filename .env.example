# --- Base de données Postgres (Supabase) --------------------------------------
# Supabase > Project Settings > Database > Connection string > « Transaction
# pooler » (port 6543), et non « Session pooler » ni la connexion directe.
#
# Le mode transaction rend la connexion à la fin de chaque requête au lieu de la
# retenir toute la session : c'est celui prévu pour le serverless. Le mode
# session plafonne à quinze clients simultanés, ce qui saturait dès que
# plusieurs builds ou scripts se croisaient.
DATABASE_URI="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Payload ------------------------------------------------------------------
# Chaîne aléatoire longue. Générer avec : openssl rand -base64 32
PAYLOAD_SECRET=""

# --- URLs ---------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# --- Supabase Storage (médias) ------------------------------------------------
# Obligatoire en production : le disque de Vercel est éphémère.
# Laisser vide en local pour écrire dans media/ à la racine.
#
# Créer un bucket public nommé « media », puis générer une clé S3 :
#   Supabase > Storage > S3 Access Keys > New access key
S3_BUCKET="media"
S3_ENDPOINT="https://<ref>.storage.supabase.co/storage/v1/s3"
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Base des URLs publiques du bucket : sert à générer des liens d'image pointant
# directement sur le CDN Supabase, sans passer par une fonction serverless.
SUPABASE_PUBLIC_URL="https://<ref>.supabase.co"

# --- Envoi des courriels (Resend) ---------------------------------------------
# Sans ces deux variables, Payload n'envoie rien : il écrit le message dans les
# journaux du serveur. Le site fonctionne, mais une demande de contact n'alerte
# personne, et « mot de passe oublié » reste sans effet.
#
# La clé se crée dans Resend > API keys, en « Sending access » plutôt qu'en
# « Full access » : le site n'a besoin que d'envoyer.
RESEND_API_KEY=""

# Expéditeur des courriels. C'est un sous-domaine dédié, et non l'adresse de
# contact de l'entreprise : envoyer depuis celle-ci imposerait de modifier les
# réglages SPF de sa messagerie, et un incident d'envoi automatique pourrait
# alors perturber la réception de son courrier courant.
COURRIEL_EXPEDITEUR="notifications@envoi.bone.fr"

# --- Origines autorisées du back-office ---------------------------------------
# Plusieurs adresses séparées par des virgules. Une origine absente de la liste
# laisse lire le back-office mais fait échouer chaque enregistrement, sans
# message qui dise pourquoi.
ORIGINES_ADMIN=""
